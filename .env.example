# ==========================================================
# Directus
# ==========================================================
# Strings aleatorios requeridos (32+ chars). Genera con: openssl rand -hex 32
DIRECTUS_KEY=replace-me-with-32-char-hex-key-aaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DIRECTUS_SECRET=replace-me-with-32-char-hex-secret-bbbbbbbbbbbbbbbbbbbbbbbbb

# Usuario admin de primera ejecución (se crea automáticamente cuando la BD está vacía).
# Tanto el backend NestJS como el contenedor de init autentican con este usuario.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin123

# ==========================================================
# Backend (NestJS)
# ==========================================================
BACKEND_PORT=3001
DIRECTUS_URL=http://directus:8055

# ==========================================================
# Frontend (Next.js)
# ==========================================================
# URL pública (visible desde el navegador) de la API NestJS.
NEXT_PUBLIC_API_URL=http://localhost:3001
